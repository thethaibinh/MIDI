<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"?>
<package format="3">
  <name>midi</name>
  <version>0.0.0</version>
  <description>The midi package</description>
  <maintainer email="thethaibinh@gmail.com">Thai Binh Nguyen</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>
  <depend>pcl_conversions</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>ground_system_msgs</depend>
  <depend>ament_index_cpp</depend>

  <!-- Note: OpenCV, Boost, OpenMP, PCL, and yaml-cpp are system dependencies
       that should be installed in the Dockerfile, not via rosdep -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
